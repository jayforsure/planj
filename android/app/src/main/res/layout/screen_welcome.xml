<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="4dp"
    android:paddingBottom="32dp">

    <com.planj.phone.HeroCard
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:heroHeadline="Your life,\nforecast honestly"
        app:heroHeight="260dp"
        app:heroSlot="welcome"
        app:heroSubline="planj learns from what you actually do and tells you the odds for tomorrow — with the one thing that would change them." />

    <Button android:id="@+id/btn_create" style="@style/Auth.Primary" android:text="Create account" />
    <Button android:id="@+id/btn_signin" style="@style/Auth.Secondary" android:text="I already have an account" />

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="End-to-end encrypted · no server ever sees your data" android:textColor="@color/idle" android:textSize="12sp" />
</LinearLayout>
