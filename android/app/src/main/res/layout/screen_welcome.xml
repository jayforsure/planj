<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="4dp"
    android:paddingBottom="32dp">

    <com.planj.phone.HeroCard
        android:id="@+id/hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:heroHeadline="Your life,\nforecast honestly"
        app:heroHeight="260dp"
        app:heroSlot="welcome" />

    <Button android:id="@+id/btn_create" style="@style/Auth.Primary" android:text="Create account" />
    <Button android:id="@+id/btn_signin" style="@style/Auth.Secondary" android:text="I already have an account" />
</LinearLayout>
