<?xml version="1.0" encoding="utf-8"?>
<!-- Page template shared by every tab: title, one-line subtitle, then sections whose
     dotted heading sits outside the card and whose content sits inside it. -->
<com.planj.phone.GestureScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:id="@+id/content"
            style="@style/Page">

            <TextView
                android:id="@+id/private_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:background="@drawable/btn_secondary"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:paddingHorizontal="16dp"
                android:paddingVertical="12dp"
                android:text="Private · not recording"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/greeting"
                style="@style/PageTitle" />

            <TextView
                android:id="@+id/header_date"
                style="@style/PageSubtitle" />

            <!-- Numbers -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/card_bg"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:paddingVertical="18dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stat_screen"
                        style="@style/StatNumber" />

                    <TextView
                        style="@style/StatLabel"
                        android:text="Screen" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stat_unlocks"
                        style="@style/StatNumber" />

                    <TextView
                        style="@style/StatLabel"
                        android:text="Unlocks" />
                </LinearLayout>

                <View
                    android:layout_width="1dp"
                    android:layout_height="36dp"
                    android:layout_gravity="center_vertical"
                    android:background="@color/border" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/stat_quiet"
                        style="@style/StatNumber" />

                    <TextView
                        android:id="@+id/stat_quiet_label"
                        style="@style/StatLabel"
                        android:text="Device-free" />
                </LinearLayout>
            </LinearLayout>

            <!-- Your day -->
            <LinearLayout style="@style/SectionRow">

                <TextView
                    android:id="@+id/day_title"
                    style="@style/SectionTitle"
                    android:text="Your day" />
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <com.planj.phone.DayTimelineView
                    android:id="@+id/timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/timeline_where"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- This week -->
            <LinearLayout style="@style/SectionRow">

                <TextView
                    style="@style/SectionTitle"
                    android:text="This week" />

                <TextView
                    android:id="@+id/week_range"
                    style="@style/SectionAside" />
            </LinearLayout>

            <LinearLayout
                style="@style/Card">

                <com.planj.phone.StackedBarChartView
                    android:id="@+id/chart"
                    android:layout_width="match_parent"
                    android:layout_height="164dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/legend"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>
            </LinearLayout>

            <!-- Apps -->
            <LinearLayout style="@style/SectionRow">

                <TextView
                    android:id="@+id/apps_title"
                    style="@style/SectionTitle"
                    android:text="Phone" />

                <TextView
                    android:id="@+id/apps_total"
                    style="@style/SectionAside"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/see_all"
                    style="@style/SectionLink"
                    android:text="See all" />
            </LinearLayout>

            <com.planj.phone.ListRow
                android:id="@+id/phone_now"
                xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:rowChevron="false" />

            <LinearLayout
                android:id="@+id/top_apps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- PC apps -->
            <LinearLayout
                android:id="@+id/pc_section"
                style="@style/SectionRow">

                <TextView
                    android:id="@+id/pc_title"
                    style="@style/SectionTitle"
                    android:text="PC" />

                <TextView
                    android:id="@+id/pc_total"
                    style="@style/SectionAside"
                    android:layout_marginEnd="8dp" />

                <TextView
                    android:id="@+id/pc_see_all"
                    style="@style/SectionLink"
                    android:text="See all" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/pc_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.planj.phone.ListRow
                    android:id="@+id/pc_now"
                    xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    app:rowChevron="false" />

                <LinearLayout
                    android:id="@+id/pc_apps"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Mood -->
            <LinearLayout style="@style/SectionRow">

                <TextView
                    android:id="@+id/mood_title"
                    style="@style/SectionTitle" />
            </LinearLayout>

            <LinearLayout style="@style/Card">

                <TextView
                    android:id="@+id/mood_state"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/mood_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal" />

                <TextView
                    android:id="@+id/mood_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/btn_text"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</com.planj.phone.GestureScrollView>
