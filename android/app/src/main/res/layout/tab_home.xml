<?xml version="1.0" encoding="utf-8"?>
<!-- Home: tomorrow's odds at a glance, and how often planj has been right. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout style="@style/Page">

        <TextView
            android:id="@+id/home_title"
            style="@style/PageTitle"
            android:text="Tomorrow" />

        <TextView
            android:id="@+id/home_date"
            style="@style/PageSubtitle" />

        <LinearLayout
            android:id="@+id/home_cards"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:orientation="vertical" />

        <TextView
            android:id="@+id/home_proof"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/btn_text"
            android:lineSpacingExtra="3dp"
            android:paddingVertical="10dp"
            android:textColor="@color/muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/home_all"
            style="@style/Pill.Secondary"
            android:layout_marginTop="12dp"
            android:text="All odds" />
    </LinearLayout>
</ScrollView>
