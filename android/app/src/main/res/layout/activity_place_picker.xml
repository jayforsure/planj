<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fitsSystemWindows="true">

    <!-- The map, with the panel sitting over its lower part -->
    <WebView
        android:id="@+id/map"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- The pin stays in the middle of the visible map; the map moves under it -->
    <FrameLayout
        android:id="@+id/pin_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clickable="false"
        android:focusable="false">

        <ImageView
            android:id="@+id/pin"
            android:layout_width="40dp"
            android:layout_height="52dp"
            android:layout_gravity="center"
            android:contentDescription="@null"
            android:src="@drawable/ic_pin" />
    </FrameLayout>

    <!-- Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="@drawable/search_bg"
            android:elevation="6dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="6dp">

            <ImageView
                android:id="@+id/back"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_text"
                android:contentDescription="Back"
                android:padding="11dp"
                android:src="@drawable/ic_back"
                android:tint="@color/text" />

            <EditText
                android:id="@+id/query"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@null"
                android:fontFamily="sans-serif"
                android:hint="Search a place or address"
                android:imeOptions="actionSearch"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingHorizontal="6dp"
                android:singleLine="true"
                android:textColor="@color/text"
                android:textColorHint="@color/muted"
                android:textSize="16sp" />

            <ImageView
                android:id="@+id/clear"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/btn_text"
                android:contentDescription="Clear"
                android:padding="12dp"
                android:src="@drawable/ic_close"
                android:tint="@color/muted"
                android:visibility="gone" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/suggestions_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/card_bg"
            android:elevation="6dp"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/suggestions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingVertical="6dp" />
        </ScrollView>
    </LinearLayout>

    <!-- The panel -->
    <LinearLayout
        android:id="@+id/sheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/locate"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_gravity="end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/btn_circle"
            android:contentDescription="My location"
            android:elevation="6dp"
            android:padding="12dp"
            android:src="@drawable/ic_mylocation"
            android:tint="@color/accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/sheet_bg"
            android:elevation="10dp"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="12dp"
            android:paddingBottom="22dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:background="@drawable/handle_bg" />

            <TextView
                android:id="@+id/place_name"
                style="@style/Heading"
                android:layout_marginTop="16dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="Move the map to the place" />

            <TextView
                android:id="@+id/place_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/muted"
                android:textSize="14sp" />

            <LinearLayout
                android:id="@+id/chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal" />

            <EditText
                android:id="@+id/label"
                style="@style/Auth.Field"
                android:layout_marginTop="14dp"
                android:hint="Name, e.g. Gym"
                android:imeOptions="actionDone"
                android:inputType="textCapWords"
                android:visibility="gone" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <Button
                    android:id="@+id/save"
                    style="@style/Pill.Primary"
                    android:text="Save place" />

                <ProgressBar
                    android:id="@+id/busy"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_gravity="center"
                    android:indeterminateTint="@color/on_accent"
                    android:visibility="gone" />
            </FrameLayout>

            <Button
                android:id="@+id/remove"
                style="@style/Auth.Link"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:text="Remove this place"
                android:textColor="@color/bad"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
