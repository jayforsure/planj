<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView style="@style/Display.XL" android:text="Settings" />

        <TextView style="@style/Auth.Section" android:text="Recording" />

        <com.planj.phone.ListRow
            android:id="@+id/row_tracking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowIcon="@drawable/ic_apps"
            app:rowTitle="Screen tracking" />

        <com.planj.phone.ListRow
            android:id="@+id/row_private"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowIcon="@drawable/ic_private"
            app:rowTitle="Private mode" />

        <com.planj.phone.ListRow
            android:id="@+id/row_private_apps"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowIcon="@drawable/ic_lock"
            app:rowTitle="Private apps" />

        <com.planj.phone.ListRow
            android:id="@+id/row_tile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowIcon="@drawable/ic_star"
            app:rowTitle="Quick Settings tile" />

        <TextView style="@style/Auth.Section" android:text="Journal" />

        <com.planj.phone.ListRow
            android:id="@+id/row_reminder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowIcon="@drawable/ic_bell"
            app:rowTitle="Evening reminder" />

        <TextView style="@style/Auth.Section" android:text="Your data" />

        <com.planj.phone.ListRow
            android:id="@+id/row_export"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowIcon="@drawable/ic_export"
            app:rowTitle="Export a copy" />

        <com.planj.phone.ListRow
            android:id="@+id/row_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowIcon="@drawable/ic_shield"
            app:rowTitle="How privacy works" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:textColor="@color/idle"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
