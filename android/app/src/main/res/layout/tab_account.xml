<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout style="@style/Page">

        <TextView
            style="@style/PageTitle"
            android:text="You" />

        <!-- Signed out -->
        <LinearLayout
            android:id="@+id/card_signedout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.planj.phone.HeroCard
                android:id="@+id/hero_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:heroButton="Create account"
                app:heroHeadline="Your life,\nforecast honestly"
                app:heroHeight="230dp"
                app:heroSlot="welcome" />

            <TextView
                style="@style/Auth.Section"
                android:text="Already with planj?" />

            <com.planj.phone.ListRow
                android:id="@+id/row_signin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_mail"
                app:rowTitle="Sign in" />

            <!-- Older code-paired phones -->
            <com.planj.phone.ListRow
                android:id="@+id/row_legacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:rowIcon="@drawable/ic_key"
                app:rowSubtitle="This phone still syncs with a key from before accounts. Tap to stop."
                app:rowTitle="Older key in use" />
        </LinearLayout>

        <!-- Signed in: profile -->
        <LinearLayout
            android:id="@+id/card_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- Who you are: one row, left-aligned like everything else -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:background="@drawable/card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="18dp">

                <FrameLayout
                    android:layout_width="64dp"
                    android:layout_height="64dp">

                    <TextView
                        android:id="@+id/avatar_initial"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/avatar_bg"
                        android:fontFamily="@font/display"
                        android:fontVariationSettings="\'wght\' 700, \'opsz\' 40, \'wdth\' 100"
                        android:gravity="center"
                        android:textColor="@color/on_accent"
                        android:textSize="28sp" />

                    <ImageView
                        android:id="@+id/avatar_photo"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:contentDescription="Your photo"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/avatar_camera"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/btn_circle_accent"
                        android:contentDescription="Change photo"
                        android:padding="5dp"
                        android:src="@drawable/ic_camera"
                        android:tint="@color/on_accent" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/display_name"
                        style="@style/Heading"
                        android:background="@drawable/btn_text"
                        android:ellipsize="end"
                        android:singleLine="true" />

                    <TextView
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:ellipsize="middle"
                        android:singleLine="true"
                        android:textColor="@color/muted"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <!-- Everything else, five rows; each opens its own page -->
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />

        <com.planj.phone.ListRow
            android:id="@+id/row_goals"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowIcon="@drawable/ic_target"
            app:rowTitle="Your goals" />

        <com.planj.phone.ListRow
            android:id="@+id/row_connectors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowIcon="@drawable/ic_sync"
            app:rowTitle="Connectors" />

        <com.planj.phone.ListRow
            android:id="@+id/row_privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowIcon="@drawable/ic_shield"
            app:rowTitle="Privacy" />

        <com.planj.phone.ListRow
            android:id="@+id/row_manage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowIcon="@drawable/ic_account"
            app:rowTitle="Account and devices" />

        <com.planj.phone.ListRow
            android:id="@+id/row_reminders"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:rowIcon="@drawable/ic_bell"
            app:rowTitle="Reminders" />

        <TextView
            android:id="@+id/version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:background="@drawable/btn_text"
            android:gravity="center"
            android:paddingVertical="10dp"
            android:textColor="@color/idle"
            android:textSize="12sp" />
    </LinearLayout>
</ScrollView>
