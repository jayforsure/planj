<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <!-- Signed out -->
        <LinearLayout
            android:id="@+id/card_signedout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.planj.phone.Illustration
                android:layout_width="match_parent"
                android:layout_height="220dp"
                android:contentDescription="hero, about 3:2"
                android:tag="welcome" />

            <TextView
                style="@style/Auth.Title"
                android:layout_marginTop="20dp"
                android:text="One account, all your devices" />

            <TextView
                style="@style/Auth.Blurb"
                android:text="Sign in on your phone and PC and they share one encrypted record. Your password locks the key; the relay only ever holds ciphertext." />

            <Button
                android:id="@+id/btn_create"
                style="@style/Auth.Primary"
                android:text="Create account" />

            <Button
                android:id="@+id/btn_signin"
                style="@style/Auth.Secondary"
                android:text="I already have an account" />

            <!-- Older code-paired phones -->
            <LinearLayout
                android:id="@+id/legacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="18dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:text="This phone still syncs with an older key from before accounts existed. Create an account to move to the new sign-in; the phone re-sends its history so nothing is lost."
                    android:textColor="@color/muted"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/btn_legacy_signout"
                    style="@style/Auth.Link"
                    android:layout_marginTop="6dp"
                    android:text="Stop using the older key" />
            </LinearLayout>
        </LinearLayout>

        <!-- Signed in: profile -->
        <LinearLayout
            android:id="@+id/card_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/avatar"
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    android:background="@drawable/avatar_bg"
                    android:fontFamily="serif"
                    android:gravity="center"
                    android:textColor="@color/on_accent"
                    android:textSize="24sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/email"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="middle"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <TextView
                        android:id="@+id/since"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <com.planj.phone.Illustration
                android:layout_width="match_parent"
                android:layout_height="140dp"
                android:layout_marginTop="20dp"
                android:contentDescription="profile banner, about 5:2"
                android:tag="profile" />

            <!-- Sync -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView style="@style/Auth.Section" android:text="SYNC" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/dot"
                        android:backgroundTint="@color/ok" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="This phone"
                        android:textColor="@color/text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/phone_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/dot_pc"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/dot" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="PC"
                        android:textColor="@color/text"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/pc_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:lineSpacingExtra="3dp"
                    android:text="To add a PC, run planj signin there with the same email and password."
                    android:textColor="@color/muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Devices -->
            <LinearLayout
                android:id="@+id/row_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="Devices"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/devices_detail"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Signed-in phones and PCs"
                        android:textColor="@color/muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="›"
                    android:textColor="@color/muted"
                    android:textSize="22sp" />
            </LinearLayout>

            <!-- Security -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingVertical="16dp">

                <TextView style="@style/Auth.Section" android:text="SECURITY" />

                <TextView
                    android:id="@+id/row_password"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_text"
                    android:gravity="center_vertical"
                    android:text="Change password"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/row_recovery"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:background="@drawable/btn_text"
                    android:gravity="center_vertical"
                    android:text="Recovery code"
                    android:textColor="@color/text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/recovery_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="-6dp"
                    android:textColor="@color/muted"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/row_signout"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/btn_text"
                    android:gravity="center_vertical"
                    android:text="Sign out on this phone"
                    android:textColor="@color/text"
                    android:textSize="15sp" />
            </LinearLayout>

            <Button
                android:id="@+id/row_delete"
                style="@style/Auth.Link"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:text="Delete account"
                android:textColor="@color/bad" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
