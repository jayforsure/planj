<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="32dp">

        <!-- Signed out -->
        <LinearLayout
            android:id="@+id/card_signedout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <com.planj.phone.HeroCard
                android:id="@+id/hero_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:heroButton="Create account"
                app:heroHeadline="Your life,\nforecast honestly"
                app:heroHeight="360dp"
                app:heroSlot="welcome"
                app:heroSubline="One account. Every device. A key only you hold." />

            <TextView
                style="@style/Auth.Section"
                android:text="Already with planj?" />

            <com.planj.phone.ListRow
                android:id="@+id/row_signin"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_mail"
                app:rowSubtitle="Use the email and password from your other device"
                app:rowTitle="Sign in" />

            <com.planj.phone.ListRow
                android:id="@+id/row_how"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_shield"
                app:rowSubtitle="What is stored, what is not, and who can read it"
                app:rowTitle="How privacy works" />

            <!-- Older code-paired phones -->
            <com.planj.phone.ListRow
                android:id="@+id/row_legacy"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:rowIcon="@drawable/ic_key"
                app:rowSubtitle="This phone still syncs with a key from before accounts. Tap to stop."
                app:rowTitle="Older key in use" />
        </LinearLayout>

        <!-- Signed in: profile -->
        <LinearLayout
            android:id="@+id/card_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp">

                <TextView
                    android:id="@+id/avatar_initial"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:background="@drawable/avatar_bg"
                    android:fontFamily="@font/display"
                    android:gravity="center"
                    android:textColor="@color/on_accent"
                    android:textSize="52sp" />

                <ImageView
                    android:id="@+id/avatar_photo"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:contentDescription="Your photo"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <ImageView
                    android:id="@+id/avatar_camera"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="bottom|end"
                    android:background="@drawable/btn_circle_accent"
                    android:contentDescription="Change photo"
                    android:padding="9dp"
                    android:src="@drawable/ic_camera"
                    android:tint="@color/on_accent" />
            </FrameLayout>

            <TextView
                android:id="@+id/display_name"
                style="@style/Display.XL"
                android:layout_marginTop="16dp"
                android:background="@drawable/btn_text"
                android:gravity="center"
                android:paddingHorizontal="12dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="Personal record"
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/email"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:background="@drawable/handle_bg"
                android:drawablePadding="8dp"
                android:drawableStart="@drawable/ic_mail"
                android:drawableTint="@color/accent"
                android:fontFamily="sans-serif-medium"
                android:gravity="center_vertical"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:textColor="@color/text"
                android:textSize="14sp" />

            <com.planj.phone.HeroCard
                android:id="@+id/hero_profile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="28dp"
                app:heroButton="See tomorrow's odds"
                app:heroHeadline="Your record,\nyour rules"
                app:heroHeight="220dp"
                app:heroSlot="profile" />

            <TextView
                style="@style/Auth.Section"
                android:text="Your account" />

            <com.planj.phone.ListRow
                android:id="@+id/row_sync"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_sync"
                app:rowTitle="Sync" />

            <com.planj.phone.ListRow
                android:id="@+id/row_devices"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_devices"
                app:rowSubtitle="Signed-in phones and PCs"
                app:rowTitle="Devices" />

            <com.planj.phone.ListRow
                android:id="@+id/row_export"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_export"
                app:rowSubtitle="Everything this phone has recorded, as a file"
                app:rowTitle="Export my data" />

            <TextView
                style="@style/Auth.Section"
                android:text="Security" />

            <com.planj.phone.ListRow
                android:id="@+id/row_password"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_lock"
                app:rowSubtitle="Signs your other devices out"
                app:rowTitle="Change password" />

            <com.planj.phone.ListRow
                android:id="@+id/row_recovery"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowIcon="@drawable/ic_key"
                app:rowTitle="Recovery code" />

            <com.planj.phone.ListRow
                android:id="@+id/row_signout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:rowChevron="false"
                app:rowIcon="@drawable/ic_back"
                app:rowSubtitle="Data stays on this phone; syncing stops"
                app:rowTitle="Sign out on this phone" />

            <com.planj.phone.ListRow
                android:id="@+id/row_delete"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                app:rowIcon="@drawable/ic_trash"
                app:rowTint="@color/bad"
                app:rowTitle="Delete account" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
