<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Display: the heavy condensed voice for headlines. Always uppercase. -->
    <!-- Display: planj's own voice. A characterful grotesk, heavy, tight, sentence case. -->
    <style name="Display" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/display</item>
        <item name="android:fontVariationSettings">\'wght\' 800, \'opsz\' 96, \'wdth\' 100</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:lineSpacingMultiplier">0.98</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Display.XL">
        <item name="android:textSize">38sp</item>
    </style>

    <style name="Display.L">
        <item name="android:textSize">31sp</item>
    </style>

    <style name="Display.M">
        <item name="android:textSize">24sp</item>
    </style>

    <!-- Heading: section titles inside a page, marked with the planj dot. -->
    <style name="Heading" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/display</item>
        <item name="android:fontVariationSettings">\'wght\' 700, \'opsz\' 40, \'wdth\' 100</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">21sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:includeFontPadding">false</item>
    </style>

    <style name="Heading.Dot">
        <item name="android:drawableStart">@drawable/dot_accent</item>
        <item name="android:drawablePadding">10dp</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="Body" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:lineSpacingExtra">4dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Auth.Title" parent="Display.L">
        <item name="android:layout_marginTop">8dp</item>
    </style>

    <style name="Auth.Blurb" parent="Body">
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="Auth.Label" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">18dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="Auth.Field" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginTop">8dp</item>
        <item name="android:background">@drawable/field_bg</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:paddingHorizontal">18dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textColorHint">@color/idle</item>
        <item name="android:textSize">16sp</item>
        <item name="android:importantForAutofill">no</item>
    </style>

    <style name="Auth.Hint" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:paddingHorizontal">4dp</item>
        <item name="android:textColor">@color/bad</item>
        <item name="android:textSize">13sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <style name="Auth.Error" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">16dp</item>
        <item name="android:background">@drawable/field_bg_error</item>
        <item name="android:paddingHorizontal">16dp</item>
        <item name="android:paddingVertical">12dp</item>
        <item name="android:textColor">@color/bad</item>
        <item name="android:textSize">14sp</item>
        <item name="android:visibility">gone</item>
    </style>

    <!-- Pills -->
    <style name="Pill" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:paddingHorizontal">22dp</item>
    </style>

    <style name="Pill.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>

    <style name="Pill.Tonal">
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <!-- Bottom sheets slide up from the edge and back down. -->
    <style name="SheetAnimation" parent="">
        <item name="android:windowEnterAnimation">@anim/sheet_in</item>
        <item name="android:windowExitAnimation">@anim/sheet_out</item>
    </style>

    <style name="Pill.Danger">
        <item name="android:background">@drawable/btn_danger</item>
        <item name="android:textColor">#FFFFFFFF</item>
    </style>

    <style name="Pill.Secondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <!-- A small pill for top bars and chip rows. -->
    <style name="Chip" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:paddingHorizontal">20dp</item>
        <item name="android:minWidth">0dp</item>
    </style>

    <style name="Chip.Primary">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">@color/on_accent</item>
    </style>

    <style name="Chip.Tonal">
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Chip.Secondary">
        <item name="android:background">@drawable/btn_secondary</item>
        <item name="android:textColor">@color/text</item>
    </style>

    <style name="Auth.Primary" parent="Pill.Primary">
        <item name="android:layout_marginTop">24dp</item>
    </style>

    <style name="Auth.Secondary" parent="Pill.Secondary">
        <item name="android:layout_marginTop">12dp</item>
    </style>

    <style name="Auth.Link" parent="android:Widget.Material.Button.Borderless">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/btn_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:paddingHorizontal">8dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/accent</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="Auth.Section" parent="Heading.Dot">
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <!-- The page template every tab follows -->
    <style name="Page" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">28dp</item>
        <item name="android:paddingBottom">32dp</item>
    </style>

    <style name="PageTitle" parent="Display.XL" />

    <style name="PageSubtitle" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">6dp</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- A section's heading line: dotted title on the left, an aside or link on the right -->
    <style name="SectionRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">32dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
    </style>

    <style name="SectionTitle" parent="Heading.Dot">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
    </style>

    <style name="SectionAside" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="SectionLink" parent="SectionAside">
        <item name="android:background">@drawable/btn_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:paddingStart">8dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:textColor">@color/accent</item>
    </style>

    <style name="Card" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/card_bg</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">20dp</item>
    </style>

    <style name="StatNumber" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">@font/display</item>
        <item name="android:fontVariationSettings">\'wght\' 700, \'opsz\' 96, \'wdth\' 100</item>
        <item name="android:includeFontPadding">false</item>
        <item name="android:letterSpacing">-0.03</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">28sp</item>
    </style>

    <style name="StatLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="Auth.Illustration" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">200dp</item>
        <item name="android:layout_marginBottom">24dp</item>
    </style>

    <!-- Round icon button (back, camera, arrow). -->
    <style name="CircleButton" parent="">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:background">@drawable/btn_circle</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:tint">@color/text</item>
    </style>

    <!-- Overline: small spaced caps for labels above numbers. -->
    <style name="Overline" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
