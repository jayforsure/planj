<?xml version="1.0" encoding="utf-8"?>
<!-- Round icon buttons: a thin outline, transparent inside, a round ripple when pressed. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="@color/ripple">
    <item>
        <shape android:shape="oval">
            <solid android:color="#00000000" />
            <stroke android:width="1.2dp" android:color="@color/border_strong" />
        </shape>
    </item>
    <item android:id="@android:id/mask">
        <shape android:shape="oval">
            <solid android:color="#FFFFFFFF" />
        </shape>
    </item>
</ripple>
