<?xml version="1.0" encoding="utf-8"?>
<!-- The odds ring: a thick ring, most of it off-white, the last stretch teal. A gauge of
     how likely, with a deliberate gap so it never reads as "complete". -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- off-white arc, 0° to 250° clockwise from 12 o'clock -->
    <path
        android:strokeColor="#EDEFF2"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:pathData="M54,28 A26,26 0 1,1 29.57,62.89" />
    <!-- teal arc, 265° to 355° -->
    <path
        android:strokeColor="#2EC4B6"
        android:strokeWidth="11"
        android:strokeLineCap="round"
        android:pathData="M28.10,56.27 A26,26 0 0,1 51.73,28.10" />
</vector>
