<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Only used to upload end-to-end encrypted data to the planj relay for your paired PC. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required by the system for a scheduled job that waits for a network connection. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Tomorrow's plans come from the calendar the user already keeps. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Places are opt-in: only a place number is ever recorded or synced. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Lets the app resolve the names and icons of the apps it reports on. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="planj"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Planj">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".AccountActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".PlacesActivity" android:exported="false" />
        <activity android:name=".PcAppsActivity" android:exported="false" />
        <activity android:name=".PlacePickerActivity" android:exported="false" android:windowSoftInputMode="adjustPan" />
        <activity android:name=".DayDetailActivity" android:exported="false" />
        <activity android:name=".AppDetailActivity" android:exported="false" />
        <activity android:name=".AppPickerActivity" android:exported="false" />


        <service
            android:name=".PrivateTileService"
            android:exported="true"
            android:icon="@drawable/ic_private"
            android:label="planj Private"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
            <meta-data android:name="android.service.quicksettings.TOGGLEABLE_TILE" android:value="true" />
        </service>

        <!-- Exported only so the system can deliver BOOT_COMPLETED to re-arm the reminder. -->
        <receiver
            android:name=".MoodReminder"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Not exported: only the system's own PendingIntents (Wi-Fi, location) reach it. -->
        <receiver
            android:name=".ArrivalWatch"
            android:exported="false" />

        <service
            android:name=".SnapshotJob"
            android:exported="false"
            android:permission="android.permission.BIND_JOB_SERVICE" />
    </application>
</manifest>
